{
  "provider": "auto",
  "nvidia_keys_directory": "nvidia_keys",
  "nvidia": {
    "api_key": "",
    "model": "meta/llama-3.3-70b-instruct",
    "max_tokens": 8192,
    "temperature": 0.1,
    "base_url": "https://integrate.api.nvidia.com/v1"
  },
  "openai": {
    "api_key": "sk-...",
    "model": "gpt-4o",
    "max_tokens": 8192,
    "temperature": 0.1
  },
  "deepseek": {
    "api_key": "sk-...",
    "model": "deepseek-chat",
    "max_tokens": 8192,
    "temperature": 0.1,
    "base_url": "https://api.deepseek.com"
  },
  "github": {
    "token": "ghp_...",
    "webhook_secret": "your-webhook-secret-here"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false
  },
  "cache": {
    "enabled": true,
    "ttl_seconds": 3600,
    "db_path": "cache.db"
  },
  "rate_limit": {
    "requests_per_minute": 20,
    "tokens_per_minute": 80000
  },
  "scanner": {
    "max_file_size_kb": 500,
    "excluded_dirs": ["node_modules", ".git", "__pycache__", ".venv", "dist", "build", ".next"],
    "included_extensions": [".py", ".js", ".ts", ".tsx", ".jsx", ".java", ".go", ".rs", ".cpp", ".c", ".cs", ".rb", ".php", ".swift", ".kt"]
  }
}
